@model IReadOnlyList<SmartWarehouse.Application.Warehouse.RfidTagRow>
@{
    ViewData["Title"] = "Thẻ RFID";
}
<div class="page-heading"><div><span class="eyebrow">NHẬN DIỆN HÀNG HÓA</span><h1>Thẻ RFID</h1><p>Mỗi EPC gắn với đúng một thẻ hàng hóa; đọc thẻ chỉ tạo sự kiện xác minh.</p></div><a class="btn btn-primary" asp-action="Create">+ Gán EPC</a></div>
<section class="panel"><div class="panel-heading"><div><h2>Danh sách EPC</h2><p>@Model.Count thẻ đã đăng ký</p></div></div><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>EPC</th><th>SKU</th><th>Sản phẩm</th><th>Trạng thái</th><th>Lần đọc cuối</th></tr></thead><tbody>@foreach(var tag in Model){<tr><td><span class="sku-code">@tag.Epc</span></td><td>@tag.Sku</td><td>@tag.ProductName</td><td><span class="status-pill status-ready">@tag.Status</span></td><td>@(tag.LastSeenAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "Chưa đọc")</td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="empty-state"><strong>Chưa có EPC</strong><p>Gán một EPC để bắt đầu xác minh hàng hóa bằng RFID.</p></div>}</section>
