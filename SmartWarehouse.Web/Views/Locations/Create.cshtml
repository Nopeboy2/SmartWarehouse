@model SmartWarehouse.Web.ViewModels.CreateLocationViewModel
@{ ViewData["Title"] = "Thêm vị trí"; }
<div class="page-heading"><div><span class="eyebrow">CẤU TRÚC KHO</span><h1>Thêm vị trí lưu trữ</h1><p>Chọn khu vực rồi đặt mã vị trí duy nhất.</p></div></div>
<section class="panel form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="ZoneId" class="form-label">Khu vực</label><select asp-for="ZoneId" asp-items="ViewBag.Zones" class="form-select"><option value="">Chọn khu vực</option></select></div><div class="mb-3"><label asp-for="Code" class="form-label">Mã vị trí</label><input asp-for="Code" class="form-control" placeholder="A-01-02"/></div><div class="mb-3"><label asp-for="Name" class="form-label">Tên</label><input asp-for="Name" class="form-control"/></div><div class="mb-3"><label asp-for="CapacityUnits" class="form-label">Sức chứa (đơn vị)</label><input asp-for="CapacityUnits" class="form-control" type="number" min="1"/></div><div class="form-actions"><a class="btn btn-light" asp-action="Index">Hủy</a><button class="btn btn-primary">Lưu vị trí</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
