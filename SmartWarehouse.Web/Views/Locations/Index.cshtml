@model IReadOnlyList<SmartWarehouse.Application.Warehouse.WarehouseLocationRow>
@{ ViewData["Title"] = "Vị trí kho"; }
<div class="page-heading"><div><span class="eyebrow">CẤU TRÚC KHO</span><h1>Vị trí lưu trữ</h1><p>Kho · khu vực · vị trí chứa hàng.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm vị trí</a></div>
<section class="panel"><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>Kho</th><th>Khu vực</th><th>Mã vị trí</th><th>Tên</th><th>Sức chứa</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var row in Model){<tr><td>@row.WarehouseCode</td><td>@row.ZoneCode</td><td><span class="sku-code">@row.Code</span></td><td>@row.Name</td><td>@row.CapacityUnits</td><td><span class="status-pill status-ready">@(row.IsActive ? "Đang dùng" : "Tạm dừng")</span></td></tr>}</tbody></table></div></section>
