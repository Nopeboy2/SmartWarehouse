@model IReadOnlyList<SmartWarehouse.Application.Warehouse.CategoryRow>
@{ ViewData["Title"] = "Danh mục"; }
<div class="page-heading"><div><span class="eyebrow">DANH MỤC HÀNG HÓA</span><h1>Danh mục</h1><p>Nhóm sản phẩm theo loại hàng trong kho.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm danh mục</a></div>
<section class="panel"><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>Mã</th><th>Tên danh mục</th><th>Số SKU</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var row in Model){<tr><td><span class="sku-code">@row.Code</span></td><td>@row.Name</td><td>@row.ProductCount</td><td><span class="status-pill status-ready">@(row.IsActive ? "Đang dùng" : "Tạm dừng")</span></td></tr>}</tbody></table></div></section>
