@model IReadOnlyList<SmartWarehouse.Application.Warehouse.AlertRow>
@{ ViewData["Title"] = "Cảnh báo"; }
<div class="page-heading"><div><span class="eyebrow">THEO DÕI NGOẠI LỆ</span><h1>Cảnh báo thiết bị</h1><p>Ghi nhận lỗi mô phỏng và xác nhận người vận hành đã xử lý.</p></div></div>
<section class="panel"><div class="table-responsive"><table class="table data-table align-middle"><thead><tr><th>Thời gian</th><th>Thiết bị</th><th>Nội dung</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var alert in Model){<tr><td>@alert.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td><td><span class="sku-code">@alert.DeviceCode</span></td><td>@alert.Message</td><td><span class="status-pill @(alert.ResolvedAt is null ? "status-error" : "status-ready")">@(alert.ResolvedAt is null ? "Chưa xử lý" : "Đã xử lý")</span></td><td>@if(alert.ResolvedAt is null){<form asp-action="Resolve" method="post"><input type="hidden" name="id" value="@alert.Id"/><button class="btn btn-light btn-sm">Đánh dấu xử lý</button></form>}</td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="empty-state"><strong>Không có cảnh báo</strong><p>Khi mô phỏng lỗi, cảnh báo sẽ xuất hiện ở đây.</p></div>}</section>
